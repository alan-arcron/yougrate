# Supabase (backend DB + Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres

# Client-side Supabase (bundled into the Vite build)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Client-side API URL (set in production to your server URL, e.g. https://api.yougrate.com)
# Leave blank for local dev — Vite proxy handles /api
VITE_API_URL=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=yougrate

# AWS SES (support ticket emails)
SES_FROM_EMAIL=noreply@arcron.systems
SES_TO_EMAIL=yougrate@arcron.systems

# Anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-7

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
PORT=3001
CLIENT_URL=http://localhost:5175
TOKEN_MARKUP_MULTIPLIER=4
BASE_FEE_CENTS=3500
# Paid "human code review" add-on price (cents). Defaults to 7500 ($75).
ADDON_CODE_REVIEW_CENTS=7500
ADMIN_EMAILS=you@example.com

# Encryption key for GitHub/Vercel tokens stored at rest (REQUIRED in production).
# Any sufficiently random string; rotating it makes existing encrypted tokens unreadable.
# Generate with: openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=
